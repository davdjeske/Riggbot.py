{
    // Terminal → Run Task…  (Ctrl+Shift+B runs the default build task: "Run riggbot")
    // Tasks use the selected Python interpreter; .vscode/settings.json points it at .venv by default.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run riggbot",
            "detail": "Start the bot (python main.py)",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["main.py"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PYTHONUTF8": "1" }
            },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "panel": "dedicated", "clear": true, "focus": true },
            "problemMatcher": []
        },
        {
            "label": "Run riggbot (debug logs)",
            "detail": "Start the bot with LOG_LEVEL=DEBUG",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["main.py"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PYTHONUTF8": "1", "LOG_LEVEL": "DEBUG" }
            },
            "group": "build",
            "presentation": { "panel": "dedicated", "clear": true, "focus": true },
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "detail": "pytest",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "-q"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Build exe",
            "detail": "PyInstaller one-file build → dist/riggbot.exe",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "PyInstaller", "riggbot.spec", "--noconfirm"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Set up environment",
            "detail": "Create .venv with Python 3.14 and install requirements-dev.txt",
            "dependsOrder": "sequence",
            "dependsOn": ["Create .venv", "Install dependencies"],
            "problemMatcher": []
        },
        {
            "label": "Create .venv",
            "type": "process",
            "command": "py",
            "args": ["-3.14", "-m", "venv", ".venv"],
            "options": { "cwd": "${workspaceFolder}" },
            "hide": true,
            "problemMatcher": []
        },
        {
            "label": "Install dependencies",
            "detail": "pip install -r requirements-dev.txt into .venv",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "pip", "install", "-r", "requirements-dev.txt"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
