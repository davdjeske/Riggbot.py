# Copy this file to .env and fill in the values. Only secrets go here;
# all other settings live in config.json (copy config.example.json).

# Required: the Discord bot token.
RIGGBOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: DeepL API key (free-plan keys end in ":fx"). Without it, DeepL is skipped.
DEEPL_API_KEY=

# Optional: only for LibreTranslate servers that require a key.
LIBRETRANSLATE_API_KEY=

# Optional overrides for config.json settings:
# LOG_LEVEL=DEBUG
# LOG_FILE_LEVEL=INFO
# LOG_COLOR=never
# LOG_DISCORD_CHANNEL_ID=123456789012345678   (or "off")
# LOG_DISCORD_LEVEL=WARNING
# DEST_LANG=en
# MANUAL_OVERRIDE_LANG=zh-CN
# TRANSLATION_PROVIDERS=deepl,googletrans,libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000
